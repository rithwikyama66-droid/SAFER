                    showToast('Maximum 5 emergency contacts limit reached.', 'warning');
                    return;
                }
                emergencyContacts.push({ name, phone, priority });
                showToast(`Added ${name} to contacts`, 'success');
            }

            renderEmergencyContacts();
            closeContactModal();
        }

        function deleteContact(idx) {
            if (idx >= 0 && idx < emergencyContacts.length) {
                const name = emergencyContacts[idx].name;
                emergencyContacts.splice(idx, 1);
                renderEmergencyContacts();
                showToast(`Removed ${name}`, 'info');
            }
        }

        // Hold-to-activate or tap SOS Panic
        function startHoldSOS() {
            holdProgress = 0;
            const progressBar = document.getElementById('sos-hold-progress');
            
            holdProgressInterval = setInterval(() => {
                holdProgress += 5;
                if (progressBar) progressBar.style.height = `${holdProgress}%`;
                if (holdProgress >= 100) {
                    cancelHoldSOS();
                    triggerSOS('Hold-to-Press Panic Button (1.5s)');
                }
            }, 75);
        }

        function cancelHoldSOS() {
            if (holdProgressInterval) clearInterval(holdProgressInterval);
            holdProgress = 0;
            const progressBar = document.getElementById('sos-hold-progress');
            if (progressBar) progressBar.style.height = '0%';
        }

        function handleSOSTap() {
            if (holdProgress < 50) {
                triggerSOS('Touch Panic SOS Tap');
            }
        }

        function triggerSOS(reason) {
            if (isSOSActive) return;
            isSOSActive = true;

            // Generate a dynamic 4-digit PIN every time SOS is activated
            currentDisarmPin = Math.floor(1000 + Math.random() * 9000).toString();
            const pinDisplay = document.getElementById('dynamic-pin-display');
            if (pinDisplay) {
                pinDisplay.innerText = currentDisarmPin;
            }

            document.getElementById('sos-trigger-reason').innerText = `Reason: ${reason}`;
            document.getElementById('sos-active-overlay').classList.remove('hidden');
            document.getElementById('sos-active-overlay').classList.add('flex');

            captureDualSnapshots(`SOS: ${reason}`);
            playEmergencySiren();
            showToast(`EMERGENCY SOS DISPATCHED! PIN: ${currentDisarmPin}`, 'error');
        }

        function disarmSOS() {
            const pin = document.getElementById('disarm-pin-input').value.trim();
            if (pin === currentDisarmPin) {
                isSOSActive = false;
                currentDisarmPin = null;
                document.getElementById('sos-active-overlay').classList.add('hidden');
                document.getElementById('sos-active-overlay').classList.remove('flex');
                document.getElementById('disarm-pin-input').value = '';
                stopEmergencySiren();
                showToast('AegisSafe Disarmed & Reset', 'success');
            } else {
                showToast('Incorrect PIN! Enter session PIN shown on screen.', 'error');
            }
        }

        // Web Audio Siren
        function playEmergencySiren() {
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                sirenOscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                sirenOscillator.type = 'sawtooth';
                sirenOscillator.frequency.setValueAtTime(850, audioCtx.currentTime);
                sirenOscillator.frequency.exponentialRampToValueAtTime(450, audioCtx.currentTime + 0.5);
                sirenOscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                sirenOscillator.start();
            } catch(e) {}
        }

        function stopEmergencySiren() {
            if (sirenOscillator) {
                try { sirenOscillator.stop(); } catch(e){}
            }
        }

        // Camera streams initialization with enhanced multi-device support
        async function initDualCameras() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                showToast('Camera API not supported on this browser/device', 'warning');
                enableRearCamFallback();
                return;
            }

            try {
                // Request initial access to list available devices
                let initialStream = null;
                try {
                    initialStream = await navigator.mediaDevices.getUserMedia({ video: true });
                } catch(e) {
                    console.warn('Initial camera prompt bypassed or fallback required');
                }
const devices = await navigator.mediaDevices.enumerateDevices().catch(() => []);
                const videoDevices = devices.filter(d => d.kind === 'videoinput');

                let frontDeviceId = null;
                let rearDeviceId = null;

                videoDevices.forEach(device => {
                    const label = device.label.toLowerCase();
                    if (label.includes('back') || label.includes('rear') || label.includes('environment') || label.includes('0')) {
                        rearDeviceId = device.deviceId;
                    } else if (label.includes('front') || label.includes('user') || label.includes('facing') || label.includes('1')) {
                        frontDeviceId = device.deviceId;
                    }
                });

                // Assign default indexes if labels are generic
                if (!frontDeviceId && videoDevices.length > 0) frontDeviceId = videoDevices[0].deviceId;
                if (!rearDeviceId && videoDevices.length > 1) rearDeviceId = videoDevices[1].deviceId;

                // 1. Initialize Front Camera Stream
                try {
                    const frontConstraints = frontDeviceId 
                        ? { video: { deviceId: { exact: frontDeviceId } } }
                        : { video: { facingMode: 'user' } };
                    
                    const frontStream = initialStream || await navigator.mediaDevices.getUserMedia(frontConstraints);
                    bindFrontCam(frontStream);
                } catch(frontErr) {
                    try {
                        const fallbackFront = await navigator.mediaDevices.getUserMedia({ video: true });
                        bindFrontCam(fallbackFront);
                    } catch(e) {
                        console.warn('Front camera stream unavailable:', e);
                    }
                }

                // 2. Initialize Rear Camera Stream
                let rearSuccess = false;

                if (rearDeviceId && rearDeviceId !== frontDeviceId) {
                    try {
                        const rearStream = await navigator.mediaDevices.getUserMedia({ video: { deviceId: { exact: rearDeviceId } } });
                        bindBackCam(rearStream);
                        rearSuccess = true;
                    } catch(e) {
                        console.warn('Exact rear deviceId request failed:', e);
                    }
                }

                if (!rearSuccess) {
                    try {
                        const environmentStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { exact: 'environment' } } });
                        bindBackCam(environmentStream);
                        rearSuccess = true;
                    } catch(e) {
                        try {
                            const fallbackEnvironment = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                            bindBackCam(fallbackEnvironment);
                            rearSuccess = true;
                        } catch(envErr) {
                            console.warn('Hardware rear camera not physically present or restricted');
                        }
                    }
                }

                // If hardware environment camera is unavailable (e.g. single-webcam desktop/laptop), activate environmental scanner stream
                if (!rearSuccess) {
                    enableRearCamFallback();
                } else {
                    currentRearMode = 'hardware';
                    showToast('Front & Rear Cameras Active', 'success');
                }

            } catch(err) {
                console.error('Dual camera init error:', err);
                enableRearCamFallback();
            }
        }

        function bindFrontCam(stream) {
            const frontVid = document.getElementById('front-cam-video');
            if (frontVid) {
                frontVid.srcObject = stream;
                frontVid.classList.remove('hidden');
                document.getElementById('front-cam-placeholder')?.classList.add('hidden');
                const status = document.getElementById('front-cam-status');
                if (status) {
                    status.innerText = "LIVE";
                    status.className = "px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[9px] font-bold";
                }
            }
            activeCameraStreams.front = stream;
        }

        function bindBackCam(stream) {
            const rearVid = document.getElementById('rear-cam-video');
            if (rearVid) {
                rearVid.srcObject = stream;
                rearVid.classList.remove('hidden');
                document.getElementById('rear-cam-placeholder')?.classList.add('hidden');
                const status = document.getElementById('rear-cam-status');
                if (status) {
                    status.innerText = "LIVE (REAR)";
                    status.className = "px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[9px] font-bold";
                }
            }
            activeCameraStreams.back = stream;
        }

        function createSimulatedRearStream() {
            if (!simulatedRearCanvas) {
                simulatedRearCanvas = document.createElement('canvas');
                simulatedRearCanvas.width = 640;
                simulatedRearCanvas.height = 360;
            }
            const ctx = simulatedRearCanvas.getContext('2d');
            let scanLine = 0;

            function renderSimulatedFeed() {
                const width = simulatedRearCanvas.width;
                const height = simulatedRearCanvas.height;

                // Night-vision tactical background
                ctx.fillStyle = '#050b14';
                ctx.fillRect(0, 0, width, height);

                // Grid lines
                ctx.strokeStyle = 'rgba(16, 185, 129, 0.15)';
                ctx.lineWidth = 1;
                const gridSize = 40;
                for (let x = 0; x < width; x += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, height);
                    ctx.stroke();
                }
                for (let y = 0; y < height; y += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(width, y);
                    ctx.stroke();
                }

                // Target box & crosshair
                ctx.strokeStyle = 'rgba(16, 185, 129, 0.6)';
                ctx.lineWidth = 2;
                ctx.strokeRect(width / 2 - 80, height / 2 - 60, 160, 120);

                ctx.beginPath();
                ctx.moveTo(width / 2 - 15, height / 2);
                ctx.lineTo(width / 2 + 15, height / 2);
                ctx.moveTo(width / 2, height / 2 - 15);
                ctx.lineTo(width / 2, height / 2 + 15);
                ctx.stroke();

                // Animated scan line
                scanLine = (scanLine + 2) % height;
                ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
                ctx.fillRect(0, scanLine, width, 6);

                // Text Overlay
                ctx.fillStyle = '#10b981';
                ctx.font = 'bold 14px monospace';
                ctx.fillText('[REAR CAM 鈥� ENV SCANNER ACTIVE]', 20, 30);

                ctx.fillStyle = '#94a3b8';
                ctx.font = '12px monospace';
                ctx.fillText(`SENSOR ID: AEGIS-REAR-ENV2`, 20, 50);
                ctx.fillText(`GPS FIX: 17.3850掳 N, 78.4867掳 E`, 20, height - 35);
                ctx.fillText(`TIME: ${new Date().toLocaleTimeString()}`, 20, height - 15);

                simulatedRearAnimId = requestAnimationFrame(renderSimulatedFeed);
            }

            if (simulatedRearAnimId) cancelAnimationFrame(simulatedRearAnimId);
            renderSimulatedFeed();

            return simulatedRearCanvas.captureStream(30);
        }

        function enableRearCamFallback() {
            const rearVid = document.getElementById('rear-cam-video');
            const placeholder = document.getElementById('rear-cam-placeholder');
            const status = document.getElementById('rear-cam-status');

            const simStream = createSimulatedRearStream();
            if (rearVid) {
                rearVid.srcObject = simStream;
                rearVid.classList.remove('hidden');
            }
            if (placeholder) placeholder.classList.add('hidden');
            if (status) {
                status.innerText = "LIVE (ENV FEED)";
                status.className = "px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 text-[9px] font-bold";
            }
            currentRearMode = 'simulated';
            showToast('Rear camera initialized with Environmental Telemetry feed', 'info');
        }

        function switchRearCamMode() {
            if (currentRearMode === 'simulated') {
                if (activeCameraStreams.front) {
                    const rearVid = document.getElementById('rear-cam-video');
                    if (rearVid) rearVid.srcObject = activeCameraStreams.front;
                    const status = document.getElementById('rear-cam-status');
                    if (status) {
                        status.innerText = "LIVE (FRONT MIRROR)";
                        status.className = "px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold";
                    }
                    currentRearMode = 'sync';
                    showToast('Switched Rear View to Mirror Feed', 'info');
                } else {
                    initDualCameras();
                }
            } else if (currentRearMode === 'sync') {
                enableRearCamFallback();
            } else {
                enableRearCamFallback();
            }
        }

        function captureDualSnapshots(source = 'Automated Trigger') {
            const gallery = document.getElementById('evidence-gallery');
            const emptyState = gallery?.querySelector('.col-span-full');
            if (emptyState) emptyState.remove();

            const canvas = document.getElementById('watermark-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.width = 400;
            canvas.height = 250;

            ctx.fillStyle = '#020617';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            const rearVid = document.getElementById('rear-cam-video');
            const frontVid = document.getElementById('front-cam-video');

            // Draw frame from live video streams if available
            try {
                if (rearVid && !rearVid.classList.contains('hidden') && rearVid.readyState >= 2) {
                    ctx.drawImage(rearVid, 0, 0, canvas.width, canvas.height);
                } else if (frontVid && !frontVid.classList.contains('hidden') && frontVid.readyState >= 2) {
                    ctx.drawImage(frontVid, 0, 0, canvas.width, canvas.height);
                }
            } catch(e) {
                console.warn('Snapshot frame capture fallback:', e);
            }

            // Stamping evidence watermark
            ctx.fillStyle = 'rgba(2, 6, 23, 0.45)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#10b981';
            ctx.font = 'bold 11px monospace';
            ctx.fillText(`AEGISSAFE EVIDENCE SNAPSHOT`, 12, 22);
            ctx.fillStyle = '#ffffff';
            ctx.font = '10px monospace';
            ctx.fillText(`GPS: 17.3850掳 N, 78.4867掳 E`, 12, 40);
            ctx.fillText(`TIME: ${new Date().toLocaleTimeString()}`, 12, 56);
            ctx.fillText(`TRIGGER: ${source.substring(0, 28)}`, 12, 72);
            ctx.fillText(`HASH: SHA256-${Math.random().toString(36).substring(2, 8).toUpperCase()}`, 12, 88);

            const dataUrl = canvas.toDataURL('image/jpeg');

            const item = document.createElement('div');
            item.className = "rounded-xl overflow-hidden border border-slate-800 bg-slate-950 p-1.5 space-y-1";
            item.innerHTML = `
                <img src="${dataUrl}" class="w-full h-20 object-cover rounded-lg">
                <p class="text-[9px] font-bold text-white truncate">${source}</p>
                <p class="text-[8px] font-mono text-emerald-400">${new Date().toLocaleTimeString()}</p>
            `;
            gallery.prepend(item);

            const count = gallery.children.length;
            const counterEl = document.getElementById('evidence-counter');
            if (counterEl) counterEl.innerText = `${count} Records`;
        }

        // Dead-Man Safety Countdown
        function startDeadManTimer(seconds) {
            stopDeadManTimer();
            deadManSeconds = seconds;
            document.getElementById('deadman-timer-display').innerText = `${deadManSeconds}s ACTIVE`;

            deadManTimer = setInterval(() => {
                deadManSeconds--;
                if (deadManSeconds <= 0) {
                    stopDeadManTimer();
                    triggerSOS('Dead-Man Countdown Timer Expiration');
                } else {
                    document.getElementById('deadman-timer-display').innerText = `${deadManSeconds}s ACTIVE`;
                }
            }, 1000);
            showToast(`Dead-Man Timer armed for ${seconds}s`, 'info');
        }

        function stopDeadManTimer() {
            if (deadManTimer) clearInterval(deadManTimer);
            document.getElementById('deadman-timer-display').innerText = "DISARMED";
        }

        function simulateShakeTrigger() {
            triggerSOS('Violent Shake Motion (>2.5g)');
        }

        function simulateVoiceTrigger() {
            triggerSOS('Voice Safe-Word ("Red Velvet")');
        }

        function initShakeDetection() {
            if (window.DeviceMotionEvent) {
                window.addEventListener('devicemotion', (e) => {
                    const acc = e.accelerationIncludingGravity;
                    if (acc && (Math.abs(acc.x) > 28 || Math.abs(acc.y) > 28)) {
                        triggerSOS('Accelerometer Hardware Shake');
                    }
                });
            }
        }

        function initSpeechRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechRecognition) {
                const recognition = new SpeechRecognition();
                recognition.continuous = true;
                recognition.onresult = (event) => {
                    const transcript = event.results[event.results.length - 1][0].transcript.toLowerCase();
                    if (transcript.includes('help') || transcript.includes('red velvet')) {
                        triggerSOS('Voice Safe-Word Trigger');
                    }
                };
                try { recognition.start(); } catch(e){}
            }
        }

        function toggleOfflineMode() {
            isOffline = !isOffline;
            const btnText = document.getElementById('connectivity-text');
            const btnIcon = document.getElementById('connectivity-icon');
            const meshStatus = document.getElementById('mesh-transport-status');

            if (isOffline) {
                btnText.innerText = "Offline";
                btnIcon.className = "fas fa-plane text-amber-400";
                if (meshStatus) meshStatus.innerText = "BLE Mesh Peer";
                showToast('Switched to Offline Cellular & BLE Mesh', 'info');
            } else {
                btnText.innerText = "Online";
                btnIcon.className = "fas fa-wifi text-emerald-400";
                if (meshStatus) meshStatus.innerText = "Cellular + BLE";
                showToast('Restored Online Cloud Channel', 'success');
            }
        }

        function toggleDeviceFrame() {
            const appShell = document.getElementById('app-shell');
            const frameBtnText = document.getElementById('frame-toggle-text');

            isDeviceFrameMode = !isDeviceFrameMode;

            if (isDeviceFrameMode) {
                appShell.className = "w-full max-w-md h-[844px] max-h-[92vh] bg-slate-950 rounded-[44px] border-[10px] border-slate-800 shadow-2xl shadow-emerald-950/20 flex flex-col relative overflow-hidden ring-1 ring-slate-700/60 transition-all duration-300";
                frameBtnText.innerText = "Full Screen";
            } else {
                appShell.className = "w-full max-w-full h-full min-h-screen bg-slate-950 rounded-none border-0 shadow-none flex flex-col relative overflow-hidden transition-all duration-300";
                frameBtnText.innerText = "Phone Frame";
            }
        }

        function toggleStealthMode() {
            const overlay = document.getElementById('stealth-calculator-overlay');
            overlay.classList.toggle('hidden');
            overlay.classList.toggle('flex');
        }

        function calcInput(val) {
            const disp = document.getElementById('calc-display');
            if (val === 'C') {
                disp.innerText = '0';
            } else if (val === '=') {
                if (disp.innerText === '911') {
                    toggleStealthMode();
                    triggerSOS('Stealth Calculator Secret 911 Code');
                } else {
                    try { disp.innerText = eval(disp.innerText); } catch(e){ disp.innerText = 'Error'; }
                }
            } else {
                if (disp.innerText === '0') disp.innerText = val;
                else disp.innerText += val;
            }
        }

        function updateTimestampDisplays() {
            const now = new Date().toISOString().replace('T', ' ').substring(0, 19);
            const frontTime = document.getElementById('front-cam-time');
            const rearTime = document.getElementById('rear-cam-time');
            if (frontTime) frontTime.innerText = `UTC: ${now}`;
            if (rearTime) rearTime.innerText = `UTC: ${now}`;
        }

        function showToast(msg, type = 'info') {
            const toast = document.createElement('div');
            let bg = 'bg-slate-800 text-slate-100 border-slate-700';
            if (type === 'success') bg = 'bg-emerald-900/90 text-emerald-100 border-emerald-500/50';
            if (type === 'error') bg = 'bg-rose-900/90 text-rose-100 border-rose-500/50';
            if (type === 'warning') bg = 'bg-amber-900/90 text-amber-100 border-amber-500/50';

            toast.className = `fixed bottom-14 left-1/2 transform -translate-x-1/2 z-50 px-3.5 py-2 rounded-xl border ${bg} text-[11px] font-semibold shadow-2xl transition-all duration-300 flex items-center gap-2 max-w-xs text-center`;
            toast.innerHTML = `<i class="fas fa-bell"></i> <span>${msg}</span>`;

            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        window.onload = function() {
            updateClock();
            setInterval(updateClock, 1000);
            updateTimestampDisplays();
            setInterval(updateTimestampDisplays, 1000);
            renderEmergencyContacts();
            checkUserProfileState();
            initShakeDetection();
            initSpeechRecognition();
        };
    </script>
