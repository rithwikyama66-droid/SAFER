        // Camera streams initialization with enhanced multi-device & mobile back-camera support
        async function initDualCameras() {
            showToast('Initializing camera sensors...', 'info');
            
            // On mobile devices, attempt to open the Back / Environment camera first
            const rearSuccess = await startRearCamera();
            
            // Attempt to open front camera if browser permits concurrent streams
            const frontSuccess = await startFrontCamera(true);

            if (rearSuccess && frontSuccess) {
                showToast('Front & Back Cameras Live Simultaneously', 'success');
            } else if (rearSuccess) {
                showToast('Back Camera Live! Tap "Flip Cam" to switch feed', 'success');
            } else if (frontSuccess) {
                showToast('Front Camera Active. Environmental Scanner Ready.', 'info');
