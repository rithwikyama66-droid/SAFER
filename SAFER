        // Dedicated Mobile Back/Rear Camera Stream Acquisition
        async function startRearCamera() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                enableRearCamFallback();
                return false;
            }

            // Clean up previous rear stream if active
            if (activeCameraStreams.back) {
                try {
                    activeCameraStreams.back.getTracks().forEach(track => track.stop());
                } catch(e) {}
                activeCameraStreams.back = null;
            }

            let stream = null;

            // Progressive fallback constraints for mobile rear camera
            const rearConstraints = [
                { video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 }, height: { ideal: 720 } } },
                { video: { facingMode: "environment" } },
                { video: { facingMode: { exact: "environment" } } }
            ];

            for (const constraint of rearConstraints) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia(constraint);
                    if (stream) break;
                } catch (e) {
                    console.warn('Rear camera constraint attempt failed:', e);
                }
            }

            // Fallback: Query device list if constraints failed
            if (!stream) {
                try {
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videoDevices = devices.filter(d => d.kind === 'videoinput');
                    
                    const rearDevice = videoDevices.find(d => {
                        const lbl = d.label.toLowerCase();
                        return lbl.includes('back') || lbl.includes('rear') || lbl.includes('environment') || lbl.includes('0') || lbl.includes('out');
                    }) || (videoDevices.length > 1 ? videoDevices[videoDevices.length - 1] : null);

                    if (rearDevice && rearDevice.deviceId) {
                        stream = await navigator.mediaDevices.getUserMedia({
                            video: { deviceId: { exact: rearDevice.deviceId } }
                        });
                    }
                } catch (e) {
                    console.warn('Enumerated back camera access attempt failed:', e);
                }
            }

            if (stream) {
                bindBackCam(stream);
                activeHardwareCam = 'back';
                currentRearMode = 'hardware';
                showToast('Back Camera activated successfully', 'success');
                return true;
            } else {
                enableRearCamFallback();
                return false;
            }
        }

        // Dedicated Mobile Front/Selfie Camera Stream Acquisition
        async function startFrontCamera(allowFail = false) {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return false;

            if (activeCameraStreams.front) {
                try {
                    activeCameraStreams.front.getTracks().forEach(track => track.stop());
                } catch(e) {}
                activeCameraStreams.front = null;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: { ideal: "user" } }
                });
                bindFrontCam(stream);
                return true;
            } catch (e) {
                if (!allowFail) console.warn('Front camera access error:', e);
                return false;
            }
        }
// Quick Flip Toggle for Mobile Hardware Cameras
        async function toggleActiveHardwareCam() {
            showToast('Flipping active camera...', 'info');
            
            if (activeHardwareCam === 'back') {
                // Switch hardware camera pipeline from Back to Front
                if (activeCameraStreams.back) {
                    try { activeCameraStreams.back.getTracks().forEach(t => t.stop()); } catch(e){}
                    activeCameraStreams.back = null;
                }
                const success = await startFrontCamera();
                if (success) {
                    activeHardwareCam = 'front';
                    enableRearCamFallback();
                    showToast('Switched hardware camera to Front Camera', 'success');
                }
            } else {
                // Switch hardware camera pipeline from Front to Back
                if (activeCameraStreams.front) {
                    try { activeCameraStreams.front.getTracks().forEach(t => t.stop()); } catch(e){}
                    activeCameraStreams.front = null;
                }
                const success = await startRearCamera();
                if (success) {
                    activeHardwareCam = 'back';
                } else {
                    await startFrontCamera();
                    activeHardwareCam = 'front';
                }
            }
        }

        function bindFrontCam(stream) {
