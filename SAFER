<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AegisSafe Mobile App</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            500: '#10b981',
                            600: '#059669',
                            900: '#064e3b',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar hiding for app-like clean look */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        @keyframes pulse-sos {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.7); }
            50% { transform: scale(1.03); box-shadow: 0 0 25px 10px rgba(225, 29, 72, 0.4); }
        }
        .animate-sos-pulse {
            animation: pulse-sos 2s infinite ease-in-out;
        }

        @keyframes radar-sweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .animate-radar {
            animation: radar-sweep 4s linear infinite;
        }

        /* Glassmorphism effects */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Custom dark theme styling for date pickers */
        input[type="date"] {
            color-scheme: dark;
        }
        input[type="date"]::-webkit-calendar-picker-indicator {
            cursor: pointer;
            filter: invert(0.8) sepia(100%) saturate(300%) hue-rotate(110deg);
        }

        /* Touch interaction optimizations */
        button, a { -webkit-tap-highlight-color: transparent; }
    </style>
</head>
<body class="h-full bg-slate-950 text-slate-100 font-sans antialiased flex flex-col justify-center items-center select-none overflow-x-hidden">

    <!-- Frame Mode Switcher Header -->
    <div class="w-full max-w-md px-4 py-2 flex items-center justify-between text-xs text-slate-400">
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="font-bold tracking-wider text-slate-300">AEGISSAFE MOBILE v3.8</span>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="toggleDeviceFrame()" id="frame-toggle-btn" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition flex items-center gap-1.5 border border-slate-700">
                <i class="fas fa-mobile-screen"></i>
                <span id="frame-toggle-text">Full Screen</span>
            </button>
            <button onclick="toggleOfflineMode()" id="connectivity-btn" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-emerald-400 font-medium transition flex items-center gap-1.5 border border-slate-700">
                <i id="connectivity-icon" class="fas fa-wifi"></i>
                <span id="connectivity-text">Online</span>
            </button>
        </div>
    </div>

    <!-- Mobile App Container Mockup -->
    <main id="app-shell" class="w-full max-w-md h-[844px] max-h-[92vh] bg-slate-950 rounded-[44px] border-[10px] border-slate-800 shadow-2xl shadow-emerald-950/20 flex flex-col relative overflow-hidden ring-1 ring-slate-700/60 transition-all duration-300">

        <!-- Mobile Dynamic Island / Top Notch & Status Bar -->
        <div class="w-full bg-slate-950/90 backdrop-blur-md pt-3 pb-1 px-6 flex items-center justify-between z-30 shrink-0 select-none">
            <!-- Digital Clock -->
            <span id="mobile-clock" class="text-xs font-bold font-mono text-slate-200">12:00</span>
            
            <!-- Dynamic Island / Sensor Notch -->
            <div class="w-24 h-5 bg-black rounded-full flex items-center justify-center gap-2 px-2 border border-slate-800/80">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[9px] font-bold text-slate-400 font-mono">ARMED</span>
            </div>

            <!-- Status Icons -->
            <div class="flex items-center gap-2 text-[11px] text-slate-300">
                <i id="status-network-icon" class="fas fa-signal"></i>
                <i class="fas fa-wifi"></i>
                <i class="fas fa-battery-three-quarters text-emerald-400"></i>
            </div>
        </div>

        <!-- Mobile App Top Bar -->
        <header class="glass-panel px-4 py-2.5 flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-950 font-black text-sm shadow-md shadow-emerald-500/20">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <div>
                    <h1 class="text-sm font-extrabold text-white tracking-wide flex items-center gap-1.5">
                        AEGISSAFE
                    </h1>
                    <p id="user-header-greeting" class="text-[10px] text-emerald-400 font-medium flex items-center gap-1">
                        <i class="fas fa-circle text-[6px]"></i> Active Protection
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-1.5">
                <!-- User Account Profile Button -->
                <button onclick="openProfileModal()" id="profile-top-btn" title="Account Profile" class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-700 text-emerald-400 hover:bg-slate-700 flex items-center justify-center transition font-bold text-xs">
                    <i id="user-profile-icon" class="fas fa-user-check text-sm"></i>
                </button>
                <!-- Stealth Disguise Button -->
                <button onclick="toggleStealthMode()" title="Camouflage Mode" class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 hover:bg-amber-500/20 flex items-center justify-center transition">
                    <i class="fas fa-calculator text-xs"></i>
                </button>
                <!-- Direct Quick SOS Pill -->
                <button onclick="triggerSOS('Top Bar SOS Button')" class="px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-black text-[11px] tracking-wider shadow-md shadow-rose-600/30 flex items-center gap-1">
                    <i class="fas fa-bolt text-[10px]"></i> SOS
                </button>
            </div>
        </header>

        <!-- NEW USER ONBOARDING SCREEN (FIRST-TIME USERS) -->
        <div id="onboarding-screen" class="absolute inset-0 z-40 bg-slate-950/95 backdrop-blur-xl flex flex-col justify-between p-5 overflow-y-auto no-scrollbar">
            <div class="space-y-4 my-auto py-4">
                <div class="text-center space-y-2">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-950 font-black text-2xl mx-auto shadow-xl shadow-emerald-500/20">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h2 id="onboarding-title" class="text-xl font-black text-white tracking-wide">Create AegisSafe Account</h2>
                    <p id="onboarding-subtitle" class="text-xs text-slate-400">Please complete your emergency dispatch profile before activating protection.</p>
                </div>

                <!-- Step 1: User Registration Form -->
                <form id="onboarding-form" onsubmit="handleRegistration(event)" class="glass-panel p-4 rounded-2xl space-y-3.5 border border-slate-800">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1">
                            <i class="fas fa-user text-emerald-400"></i> Full Name *
                        </label>
                        <input type="text" id="reg-name" required placeholder="e.g. Alex Morgan" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1">
                            <i class="fas fa-phone text-emerald-400"></i> Phone Number *
                        </label>
                        <input type="tel" id="reg-phone" required placeholder="+1 (555) 234-5678" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1">
                            <i class="fas fa-location-dot text-emerald-400"></i> Home / Emergency Address *
                        </label>
                        <textarea id="reg-address" required rows="2" placeholder="e.g. 742 Evergreen Terrace, Springfield" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 resize-none"></textarea>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1">
                            <i class="fas fa-calendar-day text-emerald-400"></i> Date of Birth *
                        </label>
                        <input type="date" id="reg-dob" required class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 cursor-pointer">
                    </div>

                    <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-500/25 transition transform active:scale-98 flex items-center justify-center gap-2">
                        <i class="fas fa-arrow-right"></i>
                        <span>Continue to Security Permissions</span>
                    </button>
                </form>

                <!-- Step 2: System Permissions Authorization (Hidden initially) -->
                <div id="permissions-step" class="glass-panel p-4 rounded-2xl space-y-3 border border-slate-800 hidden">
                    <p class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fas fa-shield-halved"></i> Device Access & Safety Clearances
                    </p>
                    <p class="text-[10px] text-slate-400 leading-relaxed">
                        To transmit live evidence and location telemetry during an active SOS, AegisSafe requires device permissions:
                    </p>

                    <div class="space-y-2 pt-1">
                        <!-- Front & Rear Camera Permission Item -->
                        <div class="p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs">
                                    <i class="fas fa-camera"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-slate-200">Front & Rear Cameras</p>
                                    <p class="text-[9px] text-slate-400">Captures encrypted evidence snapshots</p>
                                </div>
                            </div>
                            <span id="perm-cam-badge" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                Pending
                            </span>
                        </div>

                        <!-- Microphone Permission Item -->
                        <div class="p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-teal-500/20 text-teal-400 flex items-center justify-center text-xs">
                                    <i class="fas fa-microphone"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-slate-200">Microphone Access</p>
                                    <p class="text-[9px] text-slate-400">Voice Safe-Word & audio relay</p>
                                </div>
                            </div>
                            <span id="perm-mic-badge" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                Pending
                            </span>
                        </div>

                        <!-- GPS Location Access Item -->
                        <div class="p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center text-xs">
                                    <i class="fas fa-location-crosshairs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-slate-200">GPS Geolocation</p>
                                    <p class="text-[9px] text-slate-400">Live coordinates for emergency dispatch</p>
                                </div>
                            </div>
                            <span id="perm-geo-badge" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                Pending
                            </span>
                        </div>
                    </div>

                    <div class="space-y-2 pt-2">
                        <button onclick="requestAllDevicePermissions()" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-500/20 transition flex items-center justify-center gap-2">
                            <i class="fas fa-key"></i>
                            <span>Grant Permissions & Enter App</span>
                        </button>
                        <button onclick="finalizeOnboarding()" id="finish-onboarding-btn" class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition flex items-center justify-center gap-1.5">
                            <i class="fas fa-shield-check text-emerald-400"></i>
                            <span>Skip & Enter Directly</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="text-center text-[10px] text-slate-500 font-mono">
                AEGISSAFE SECURE PROFILE ENCRYPTION • VER 3.8
            </div>
        </div>

        <!-- App Screens Container (Scrollable) -->
        <div id="screens-viewport" class="flex-1 overflow-y-auto no-scrollbar relative p-4 space-y-4">

            <!-- TAB 1: HOME / DASHBOARD SCREEN -->
            <section id="screen-home" class="tab-screen space-y-4">
                
                <!-- Main SOS Panic Center -->
                <div class="glass-panel rounded-3xl p-6 text-center flex flex-col items-center justify-center relative overflow-hidden border border-rose-500/20">
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-rose-500/10 rounded-full blur-2xl"></div>
                    <div class="absolute -left-10 -top-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl"></div>

                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Hold for 1.5s or Tap to Panic</p>

                    <!-- Interactive Animated Panic Trigger Button -->
                    <button id="sos-touch-btn" 
                            onmousedown="startHoldSOS()" 
                            onmouseup="cancelHoldSOS()" 
                            mouseleave="cancelHoldSOS()"
                            ontouchstart="startHoldSOS()" 
                            ontouchend="cancelHoldSOS()"
                            onclick="handleSOSTap()" 
                            class="w-36 h-36 rounded-full bg-gradient-to-br from-rose-500 via-rose-600 to-red-700 text-white shadow-2xl shadow-rose-600/50 flex flex-col items-center justify-center border-4 border-rose-400/40 animate-sos-pulse active:scale-95 transition-transform duration-150 relative overflow-hidden group">
                        
                        <!-- Progress Overlay for Press Hold -->
                        <div id="sos-hold-progress" class="absolute bottom-0 left-0 right-0 bg-rose-950/80 transition-all duration-75 h-0 pointer-events-none"></div>
                        
                        <i class="fas fa-fingerprint text-4xl mb-1 group-hover:scale-110 transition-transform"></i>
                        <span class="font-black text-xl tracking-wider">PANIC</span>
                        <span class="text-[9px] font-bold text-rose-200 tracking-widest uppercase">DISPATCH SOS</span>
                    </button>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-slate-300 bg-slate-900/60 px-3 py-1.5 rounded-full border border-slate-800">
                        <i class="fas fa-location-dot text-emerald-400"></i>
                        <span class="font-mono text-[11px]">17.3850° N, 78.4867° E</span>
                    </div>
                </div>

                <!-- Active Security Status Grid -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="glass-panel p-3.5 rounded-2xl flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <div>
                    <p class="text-[10px] text-slate-400 uppercase font-semibold">Guard Status</p>
                            <p class="text-xs font-bold text-slate-100">Armed & Armed</p>
                        </div>
                    </div>

                    <div class="glass-panel p-3.5 rounded-2xl flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-lg">
                            <i class="fas fa-tower-cell"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-semibold">Mesh Transport</p>
                            <p id="mesh-transport-status" class="text-xs font-bold text-slate-100">Cellular + BLE</p>
                        </div>
                    </div>
                </div>

                <!-- Fast Action Safety Widgets -->
                <div class="glass-panel rounded-2xl p-4 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                        <h2 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fas fa-bolt text-amber-400"></i> Quick Safety Triggers
                        </h2>
                        <span class="text-[10px] font-semibold text-emerald-400">3 Active</span>
                    </div>

                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="simulateShakeTrigger()" class="p-2.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-center space-y-1 transition">
                            <i class="fas fa-mobile-screen-button text-amber-400 text-base"></i>
                            <p class="text-[10px] font-bold text-slate-200">Shake Trigger</p>
                            <p class="text-[8px] text-slate-400">>2.5g G-Force</p>
                        </button>

                        <button onclick="simulateVoiceTrigger()" class="p-2.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-center space-y-1 transition">
                            <i class="fas fa-microphone text-rose-400 text-base"></i>
                            <p class="text-[10px] font-bold text-slate-200">Safe-Word</p>
                            <p class="text-[8px] text-slate-400">"Red Velvet"</p>
                        </button>

                        <button onclick="switchTab('triggers')" class="p-2.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-center space-y-1 transition">
                            <i class="fas fa-stopwatch text-sky-400 text-base"></i>
                            <p class="text-[10px] font-bold text-slate-200">Safety Timer</p>
                            <p class="text-[8px] text-slate-400">Dead-Man</p>
                        </button>
                    </div>
                </div>

                <!-- Emergency Dispatch Quick Preview -->
                <div class="glass-panel rounded-2xl p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fas fa-phone text-emerald-400"></i> Dispatch Contacts
                        </h2>
                        <button onclick="switchTab('contacts')" class="text-[11px] text-emerald-400 hover:underline font-semibold">Manage</button>
                    </div>
                    <div id="home-contacts-preview" class="space-y-2">
                        <!-- Rendered dynamically -->
                    </div>
                </div>

            </section>

            <!-- TAB 2: ZERO-TOUCH TRIGGERS SCREEN -->
            <section id="screen-triggers" class="tab-screen space-y-4 hidden">
                <div class="glass-panel rounded-2xl p-4 space-y-3">
                    <h2 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fas fa-shield-virus text-amber-400"></i> Zero-Touch Passive Triggers
                    </h2>
                    <p class="text-xs text-slate-400">Automated panic triggers respond instantly without requiring screen interaction.</p>
                </div>

                <!-- Dead-Man Safety Timer Widget -->
                <div class="glass-panel rounded-2xl p-4 space-y-4 border border-amber-500/20">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm">
                                <i class="fas fa-stopwatch"></i>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-white">Dead-Man Safety Timer</h3>
                                <p class="text-[10px] text-slate-400">Auto-triggers SOS if not disarmed in time</p>
                            </div>
                        </div>
                        <span id="deadman-timer-display" class="font-mono text-xs font-bold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-lg border border-amber-500/20">
                            DISARMED
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="startDeadManTimer(15)" class="py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs font-bold border border-amber-500/30 transition">15s Alert</button>
                        <button onclick="startDeadManTimer(30)" class="py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs font-bold border border-amber-500/30 transition">30s Timer</button>
                        <button onclick="startDeadManTimer(60)" class="py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs font-bold border border-amber-500/30 transition">60s Timer</button>
                    </div>
                    <button 
onclick="stopDeadManTimer()" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 transition">
                        Clear & Reset Timer
                    </button>
                </div>

                <!-- Motion & Accelerometer Trigger Card -->
                <div class="glass-panel rounded-2xl p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center text-sm">
                                <i class="fas fa-mobile-retro"></i>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-white">Violent Motion / Shake</h3>
                                <p class="text-[10px] text-slate-400">Triggers on rapid hardware shake</p>
                            </div>
                        </div>
                        <button onclick="simulateShakeTrigger()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition">
                            Test Shake
                        </button>
                    </div>
                </div>

                <!-- Voice Safe-Word Keyword Listener -->
                <div class="glass-panel rounded-2xl p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-teal-500/20 text-teal-400 flex items-center justify-center text-sm">
                                <i class="fas fa-microphone"></i>
                            </div>
                            <div>
