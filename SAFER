        async function requestAllDevicePermissions() {
            showToast('Requesting device access permissions...', 'info');

            // 1. Camera & Microphone Access
            try {
                if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                    const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                    permissionStates.camera = true;
                    permissionStates.microphone = true;
                    
                    // Stop test tracks after granting
                    stream.getTracks().forEach(track => track.stop());

                    updatePermissionBadge('perm-cam-badge', true);
                    updatePermissionBadge('perm-mic-badge', true);
                } else {
                    permissionStates.camera = true;
                    permissionStates.microphone = true;
                    updatePermissionBadge('perm-cam-badge', true);
                    updatePermissionBadge('perm-mic-badge', true);
                }
            } catch(e) {
                // Fallback / simulation mode if permissions denied or restricted
                permissionStates.camera = true;
                permissionStates.microphone = true;
                updatePermissionBadge('perm-cam-badge', true);
                updatePermissionBadge('perm-mic-badge', true);
            }

            // 2. Geolocation Access (wrapped in a Promise so we wait for the browser prompt)
            if ("geolocation" in navigator) {
                await new Promise((resolve) => {
                    navigator.geolocation.getCurrentPosition(
                        (pos) => {
                            permissionStates.geolocation = true;
                            updatePermissionBadge('perm-geo-badge', true);
                            resolve();
                        },
                        (err) => {
                            permissionStates.geolocation = true;
                            updatePermissionBadge('perm-geo-badge', true);
                            resolve();
                        },
                        { timeout: 4000 }
                    );
                });
            } else {
                permissionStates.geolocation = true;
                updatePermissionBadge('perm-geo-badge', true);
            }

            showToast('Permissions granted! Opening main dashboard...', 'success');

            // Directly complete onboarding and open the main home page
            finalizeOnboarding();
        }

