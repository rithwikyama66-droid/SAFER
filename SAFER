        function createSimulatedRearStream() {
            if (!simulatedRearCanvas) {
                simulatedRearCanvas = document.createElement('canvas');
                simulatedRearCanvas.width = 640;
                simulatedRearCanvas.height = 360;
            }
            const ctx = simulatedRearCanvas.getContext('2d');
            let scanLine = 0;

            function renderSimulatedFeed() {
                const width = simulatedRearCanvas.width;
                const height = simulatedRearCanvas.height;

                // Night-vision tactical background
                ctx.fillStyle = '#050b14';
                ctx.fillRect(0, 0, width, height);

                // Grid lines
                ctx.strokeStyle = 'rgba(16, 185, 129, 0.15)';
                ctx.lineWidth = 1;
                const gridSize = 40;
                for (let x = 0; x < width; x += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, height);
                    ctx.stroke();
                }
                for (let y = 0; y < height; y += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(width, y);
                    ctx.stroke();
                }

                // Target box & crosshair
                ctx.strokeStyle = 'rgba(16, 185, 129, 0.6)';
                ctx.lineWidth = 2;
                ctx.strokeRect(width / 2 - 80, height / 2 - 60, 160, 120);

                ctx.beginPath();
                ctx.moveTo(width / 2 - 15, height / 2);
                ctx.lineTo(width / 2 + 15, height / 2);
                ctx.moveTo(width / 2, height / 2 - 15);
                ctx.lineTo(width / 2, height / 2 + 15);
                ctx.stroke();

                // Animated scan line
                scanLine = (scanLine + 2) % height;
                ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
                ctx.fillRect(0, scanLine, width, 6);

                // Text Overlay
                ctx.fillStyle = '#10b981';
                ctx.font = 'bold 14px monospace';
                ctx.fillText('[REAR CAM 鈥� ENV SCANNER ACTIVE]', 20, 30);

                ctx.fillStyle = '#94a3b8';
                ctx.font = '12px monospace';
                ctx.fillText(`SENSOR ID: AEGIS-REAR-ENV2`, 20, 50);
                ctx.fillText(`GPS FIX: 17.3850掳 N, 78.4867掳 E`, 20, height - 35);
                ctx.fillText(`TIME: ${new Date().toLocaleTimeString()}`, 20, height - 15);

                simulatedRearAnimId = requestAnimationFrame(renderSimulatedFeed);
            }

            if (simulatedRearAnimId) cancelAnimationFrame(simulatedRearAnimId);
            renderSimulatedFeed();

            return simulatedRearCanvas.captureStream(30);
        }

